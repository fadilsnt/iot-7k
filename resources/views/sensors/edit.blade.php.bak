    @push('scripts')
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sensorTemplate = document.getElementById('sensorTemplate');
            const sensorsContainer = document.getElementById('sensorsContainer');
            const addSensorBtn = document.getElementById('addSensorBtn');
            let sensorCount = sensorsContainer.children.length;

            function addSensor() {
                sensorCount++;
                const sensor = sensorTemplate.content.cloneNode(true);
                sensor.querySelector('.sensor-number').textContent = sensorCount;

                const removeBtn = sensor.querySelector('.btn-remove-sensor');
                removeBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    sensorsContainer.lastChild.remove();
                    updateSensorNumbers();
                });

                sensorsContainer.appendChild(sensor);
            }

            function updateSensorNumbers() {
                const sensors = sensorsContainer.querySelectorAll('.sensor-block');
                sensors.forEach((sensor, idx) => {
                    sensor.querySelector('.sensor-number').textContent = idx + 1;
                });
                sensorCount = sensors.length;
            }

            // Attach remove handlers to existing sensors
            document.querySelectorAll('.btn-remove-sensor').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    btn.closest('.sensor-block').remove();
                    updateSensorNumbers();
                });
            });

            // Add sensor button
            addSensorBtn.addEventListener('click', (e) => {
                e.preventDefault();
                addSensor();
            });
        });
    </script>
    @endpush
</x-app-layout>
